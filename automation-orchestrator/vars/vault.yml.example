# Ansible Automation Portal — all deployment variables
# Copy to vault.yml, fill in, then encrypt:
#   ansible-vault encrypt vars/vault.yml
#
# Run with:
#   ansible-playbook deploy-automation-portal.yml --ask-vault-pass

# --- AAP connection ---
aap_host: "https://aap.example.com"
aap_admin_user: "admin"
aap_admin_password: "changeme"
aap_validate_certs: false

# --- AAP organization ---
aap_organization: "Default"

# --- OpenShift connection ---
ocp_api_url: "https://api.ocp.example.com:6443"
ocp_token: "sha256~..."
ocp_validate_certs: false

# --- Portal namespace ---
ocp_project: "ansible-automation-portal"

# --- Helm release ---
helm_release_name: "redhat-rhaap-portal"
helm_chart_repo: "https://charts.openshift.io/"
helm_chart_name: "openshift-helm-charts/redhat-rhaap-portal"
# helm_chart_version: "1.0.1"

# --- OCP cluster router base ---
ocp_cluster_router_base: "apps.ocp.example.com"

# --- Plugin delivery ---
plugin_mode: "oci"
image_tag_info: "2.2"

# --- registry.redhat.io credentials ---
registry_username: ""
registry_password: ""

# --- Self-signed certs ---
portal_check_ssl: false

# --- SCM integration (optional) ---
# github_token: ""
# gitlab_token: ""
