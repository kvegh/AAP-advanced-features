---
# Copy to vault.yml, fill in values, and encrypt: ansible-vault encrypt vars/vault.yml
# Commit the encrypted file to git. AAP decrypts at runtime via Vault credential.

# OCP cluster credentials
ocp_api_url: "https://api.cluster.example.com:6443"
ocp_api_token: "sha256~xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Orchestrator route hostname (must resolve to OCP router)
orchestrator_route_host: "orchestrator.apps.cluster.example.com"

# AAP Gateway URL (for Orchestrator API config)
aap_gateway_url: "https://aap.example.com"

# Pre-created OAuth app credentials (create in AAP UI or API first)
oauth_client_id: "your-client-id"
oauth_client_secret: "your-client-secret"

# Pre-created service account credentials (create in AAP UI or API first)
svc_account_username: "orchestrator_svc"
svc_account_password: "your-service-account-password"
